# Copy to .env and fill in. Everything is optional: without a provider key the app uses an offline echo model.
# SQLite locally. For Postgres (Neon, Render, RDS) paste the connection string as given, for example
# postgresql://user:pass@host/db?sslmode=require; it is switched to the psycopg driver automatically.
DATABASE_URL=sqlite:///./headnote.db
# Chat model: auto (default), anthropic, openai or echo. auto picks Anthropic if ANTHROPIC_API_KEY is set,
# then OpenAI if OPENAI_API_KEY is set, otherwise the echo model.
LLM_PROVIDER=auto
ANTHROPIC_API_KEY=
# claude-haiku-5-5 is the cheap default; claude-sonnet-5-5 gives stronger answers.
ANTHROPIC_MODEL=claude-haiku-5-5
# OpenAI is optional. When its key is set it also provides the document embeddings.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Comma-separated origins allowed to call the API cross-origin (only needed when the web app is on
# another origin, for example https://headnote.example.com). Leave empty behind the /api proxy.
CORS_ORIGINS=
# Set a directory to persist the Chroma index across restarts.
CHROMA_PATH=
# Index the sample documents in apps/api/app/demo_docs at startup when the index is empty. Turn on where the
# disk is ephemeral (Render free) so the demo is never empty after a restart.
SEED_DEMO_DOCUMENTS=false

# LangSmith tracing
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=headnote
